<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer policy.

  android:allowBackup="false" disables cloud backup, but on devices from some
  manufacturers it does NOT disable device-to-device (D2D) migration for apps
  targeting API 31+. The secure store (FlutterSecureStorage / EncryptedShared
  Preferences) and the session database must never leave the device, so both
  channels are excluded explicitly for every domain.

  API 24-30 keep using android:allowBackup="false" (and
  android:fullBackupContent="false"), which is definitive there.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
