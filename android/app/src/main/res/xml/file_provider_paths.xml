<?xml version="1.0" encoding="utf-8"?>
<!-- M2: the provider exposes ONLY the share staging directory. Every outgoing
     file (share, transcript, open-with) is first copied into
     cache/outgoing-shares/<random>/ by NativeShare, so no other app-private
     path (files, databases, prefs, external app dirs) is ever addressable
     through a content:// URI. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="outgoing_shares" path="outgoing-shares/" />
</paths>
