# Ovid gateway — Caddy route for the image service + masked model catalog.
#
# These blocks MUST appear before the LiteLLM `/v1/*` catch-all in
# api.ovidsi.com, so image and catalog traffic reaches the mint app
# (127.0.0.1:8090) instead of LiteLLM (127.0.0.1:4000). Everything else under
# /v1/* (chat, embeddings, ...) keeps going to LiteLLM.
#
# Paste inside the `api.ovidsi.com { ... }` site block:

	# Ovid image service + masked model catalog → mint verifier (must precede
	# the LiteLLM /v1/* rule). The image routes are mounted on the mint app.
	@images path /v1/images/* /v1/models
	handle @images {
		reverse_proxy 127.0.0.1:8090
	}

	@api path /v1/* /health /health/* /models
	handle @api {
		reverse_proxy 127.0.0.1:4000 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
				dial_timeout 10s
			}
		}
	}

# Reload after editing:
#   docker compose exec -T caddy caddy validate --config /etc/caddy/Caddyfile
#   docker compose exec -T caddy caddy reload   --config /etc/caddy/Caddyfile
