# No Firebase, LiteLLM, Redis or mint credentials are needed by retention.
ACCOUNT_STORE_CONFIG=/etc/ovid-account/stores.json
ACCOUNT_DATABASE_URL=postgresql://ovid_account:REPLACE@postgres.invalid/ovid_account
PRIVATE_SYNC_CONFIGURED=true
PRIVATE_SYNC_ACTIVATED=false
PRIVATE_SYNC_AUTHORITY_ID=33333333-3333-4333-8333-333333333333
LIVE_COLLABORATION_CONFIGURED=true
LIVE_COLLABORATION_ACTIVATED=false
# Match API/worker backend and identity, even with HTTP disabled. For postgres,
# remove DATABASE_PATH; AUTHORITY_ID is the persisted authority's UUID suffix.
LIVE_COLLABORATION_BACKEND=sqlite
LIVE_COLLABORATION_DATABASE_PATH=/var/lib/ovid-account/collaboration.db
LIVE_COLLABORATION_AUTHORITY_ID=44444444-4444-4444-8444-444444444444
