# Nonsecret template. Replace inventory values; keep this file out of images.
# Supply real credentials in /etc/ovid-account/api.env (0640 service-readable).
ACCOUNT_ACTIVATED=false
ACCOUNT_DATABASE_URL=postgresql://ovid_account:REPLACE@postgres.invalid/ovid_account
ACCOUNT_STORE_CONFIG=/etc/ovid-account/stores.json
ACCOUNT_CLEANUP_MANIFEST=/etc/ovid-account/cleanup-manifest.json
FIREBASE_PROJECT_ID=REPLACE
ACCOUNT_FIREBASE_APP_IDS=REPLACE
GOOGLE_APPLICATION_CREDENTIALS=/etc/ovid-account/firebase-admin.json
LITELLM_DATABASE_URL=postgresql://ovid_cleanup:REPLACE@postgres.invalid/litellm
LITELLM_BASE=https://litellm.internal.invalid
LITELLM_MASTER_KEY=REPLACE
REDIS_URL=redis://:REPLACE@redis.internal.invalid:6379/0
SHARE_BASE_URL=https://account.example.invalid

# Once configured, retain these authorities even when route activation is false.
PRIVATE_SYNC_CONFIGURED=true
PRIVATE_SYNC_ACTIVATED=false
PRIVATE_SYNC_AUTHORITY_ID=33333333-3333-4333-8333-333333333333
# Optional legacy override, absent by default:
# PRIVATE_SYNC_REPOSITORY_FACTORY=package.module:factory
LIVE_COLLABORATION_CONFIGURED=true
LIVE_COLLABORATION_ACTIVATED=false
# Default remains sqlite. For postgres, remove DATABASE_PATH and use the UUID
# suffix of migrate identity's persisted collaboration:postgres:<uuid> value.
# PostgreSQL uses ACCOUNT_DATABASE_URL and the lifecycle table's schema.
LIVE_COLLABORATION_BACKEND=sqlite
LIVE_COLLABORATION_DATABASE_PATH=/var/lib/ovid-account/collaboration.db
LIVE_COLLABORATION_AUTHORITY_ID=44444444-4444-4444-8444-444444444444

# Caddy host configuration (public DNS must match SHARE_BASE_URL).
OVID_ACCOUNT_HOST=account.example.invalid
