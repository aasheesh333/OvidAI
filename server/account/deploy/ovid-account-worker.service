[Unit]
Description=Ovid durable account deletion sweep
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Deployment MUST supply User, WorkingDirectory, EnvironmentFile, ExecStart,
# and ReadWritePaths using a drop-in. No guessed host paths are supplied.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=15min
