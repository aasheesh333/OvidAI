# /etc/systemd/system/ovid-account-worker.service.d/host.conf
[Service]
User=ovid-account
Group=ovid-account
WorkingDirectory=/opt/ovid-account
EnvironmentFile=/etc/ovid-account/api.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ovid-account/venv/bin/python -m server.account.worker
ReadWritePaths=/var/lib/ovid-account
UMask=0077
