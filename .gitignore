# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
# Agent working scratch (briefs, reports, ledgers) — local only, never tracked.
# Tracked design records live under docs/superpowers/ instead.
.superpowers/
# Large tool-output dumps and throwaway analysis scripts.
.spill/
.scratch/
# Audit scratch: pre-patch file backups, anchored patch scripts, downloaded
# upstream reference sources. Never part of a commit.
.audit/
.oc/
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
