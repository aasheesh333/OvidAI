# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# build outputs
docs/*.apk
*.apk


# Firebase + signing secrets — injected via CI, never commit
android/app/google-services.json
google-services.json
android/keystore.properties
android/release-keystore.jks
*.jks
*.keystore
keystore.properties
android/app/src/main/jniLibs/*/libovid_bootstrap.so
android/build/

# Live provider probing scratch: raw /v1/models dumps and 400-body transcripts.
# Local only — the probe logs are provider responses captured with private
# keys, and nothing here is a source of truth (the vetted numbers live in
# lib/core/model_limits.dart instead).
.prov/
