#!/bin/sh
# docker — blocks `docker build` only (spec §7); other subcommands (ps, pull,
# run, …) pass through to a real docker outside /usr/local/bin, if any.
if [ "${1:-}" = "build" ]; then
  echo "Heavy native compilation (APK/Gradle/Kotlin builds) is disabled on live cloud workspaces. Use GitHub Actions CI or syntax/lint preview mode instead."
  exit 126
fi
for d in /usr/bin /bin; do [ -x "$d/docker" ] && exec "$d/docker" "$@"; done
echo "docker: not installed in cloud workspaces" >&2; exit 127
