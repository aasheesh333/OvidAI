# Ovid cloud worker — the systemd replacement for the P1 compose `worker`
# service (DEPLOY.md §11 step 6-7 transitions it). Runs on the HOST (not in
# Docker): SandboxManager needs cgroup.procs pre-setuid attach, the
# /workspaces XFS volume and nftables adjacency, none of which survive a
# container boundary.
#
# OWNER-GATED artifact: installed by DEPLOY.md §11 step 5, never by a task
# agent. Everything here is pinned by that runbook; edit the copies in
# /etc/systemd/system only via a repo change + reinstall.
[Unit]
Description=Ovid cloud worker (agent runs + SandboxManager)
# docker.service: not a hard runtime dep (the worker talks to redis/postgres
# over loopback proxies), but ordering after it keeps the proxy containers
# up first on a fresh boot.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Slice=ovid-sandboxes.slice
# research §8.1: root needed for cgroup.procs pre-setuid attach, /workspaces
# binds, nftables adjacency; de-rooting path (Delegate=yes + leaf-first,
# research §3 TEST C) documented in HARDENING item H
User=root
# G5 (P6 pre-flight ruling): caps the worker unit INSIDE the 10G slice —
# worker proper ~2G + P6 browser pool ~2G run under this unit; jail envs get
# the remaining ≥6G of the slice; slice MemoryMax=10G and the
# Global-Constraints envelope arithmetic are unchanged
MemoryMax=4096M
# REQUIRED: SandboxManager creates `worker/` and `sandbox-<uid>/` leaf cgroups
# under THIS unit's cgroup and enables memory/pids/cpu on them. Without
# delegation systemd leaves the parent slice's cgroup.subtree_control empty,
# so this cgroup has no controllers available and every write to its own
# cgroup.subtree_control fails (the worker crash-loops at SandboxManager
# init). Delegate=yes hands the subtree to the service, which is the
# documented "leaf-first" model in research §3 TEST C.
Delegate=yes
# systemd 255 on this host does not enable any controller on the PARENT slice
# when a child unit asks for one (observed: ovid.slice has
# `cpuset cpu io memory pids`, ovid-sandboxes.slice stays empty even though
# this unit sets MemoryMax). With an empty parent subtree_control this unit's
# cgroup has NO controllers available, and enabling "+cpu +memory +pids" on it
# then fails with ENOENT (cgroup v2 returns ENOENT for an unavailable
# controller) — the worker crash-looped at SandboxManager init. Enable the
# three controllers the sandbox leaves need on the slice first. cgroupfs is
# ephemeral, so this must run on every boot: hence ExecStartPre, not a manual
# one-off.
ExecStartPre=/bin/sh -c 'echo "+cpu +memory +pids" > /sys/fs/cgroup/ovid-sandboxes.slice/cgroup.subtree_control'
WorkingDirectory=/opt/ovid-cloud/repo/cloud
EnvironmentFile=/opt/ovid-cloud/worker.env
ExecStart=/usr/bin/node apps/worker/dist/main.js
Restart=always
RestartSec=5
# worker drains SIGTERM in ≤30 s (P1)
TimeoutStopSec=35
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
