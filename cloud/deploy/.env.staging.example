# Ovid Cloud P10 — STAGING environment template (gateway + host worker).
#
# Copy to `cloud/deploy/.env.staging` (gitignored), then `chmod 600`. Every
# value here is staging-only; none of them may equal a production value.
# `cloud/scripts/staging.sh guard` refuses to start if any production-valued
# env slips in (prod database/redis/mint/uid base/workspace root/ports).
#
# This file is the HOST-SIDE view: it is consumed by the staging worker
# (`staging.sh worker-start`) and by `staging.sh env`. The gateway container
# also loads it via `env_file`, but docker-compose.staging.yml overrides the
# backend URLs with compose service names for the container network.
#
# Format: plain KEY=VALUE shell syntax (staging.sh sources it). No inline
# comments after values.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
OVID_AUTH_MODE=test

# ── Staging bind/publication guard ─────────────────────────────────────────
# Every published staging port must stay loopback-only. There are TWO host
# non-loopback listeners, both firewall-denied externally: the mock LiteLLM
# (0.0.0.0:14000) — required so the gateway container can reach it over the
# docker bridge — and the host-run worker's internal file service
# (0.0.0.0:18093, OVID_WORKER_FILE_PORT). The host firewall must keep BOTH
# 14000 and 18093 closed to the outside.
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_GATEWAY_URL=http://127.0.0.1:18082
STAGING_MOCK_LLM_URL=http://127.0.0.1:14000
STAGING_WORKER_PIDFILE=/tmp/opencode/ovid-staging-worker.pid
STAGING_MOCK_PIDFILE=/tmp/opencode/ovid-staging-mock.pid

# ── Staging Postgres (dedicated container) ─────────────────────────────────
DATABASE_URL=postgres://postgres:staging@127.0.0.1:15432/ovid_cloud_staging
STAGING_PG_PASSWORD=staging

# ── Staging redis-q (dedicated instance) ───────────────────────────────────
REDIS_Q_URL=redis://:staging@127.0.0.1:16379
REDIS_Q_PASSWORD=staging

# ── Staging mint (REAL P9 service) + its db2 projection ────────────────────
# Container-side the gateway uses redis-mint:6379 and http://mint:8092
# (compose overrides); the host worker uses the published ports below.
REDIS_MINT_URL=redis://:staging@127.0.0.1:16380/2
REDIS_MINT_PASSWORD=staging
OVID_INTERNAL_MINT_URL=http://127.0.0.1:18092
# Shared secret for P9 Task 9's HMAC internal mint surface (>= 32 bytes).
# Staging-only literal — never reuse the production value.
OVID_INTERNAL_API_SECRET=staging-internal-api-secret-0123456789abcdef0123456789abcdef

# NOTE: MINT_BASE_URL MUST NOT APPEAR HERE. P9 Task 9 deletes the pre-P9
# HTTP-mint provisioner surface; its presence is a prod/leftover smell and
# `staging.sh guard` rejects it.

# ── Model routing (host-bound mock LiteLLM) ────────────────────────────────
# 172.17.0.1 is the docker0 bridge-gateway address of this host; the mock
# listens on 0.0.0.0:14000. Never point this at the live LiteLLM (:4000).
OVID_LITELLM_BASE=http://172.17.0.1:14000
OVID_DEFAULT_MODEL=mock-model

# ── Queue / worker tuning ──────────────────────────────────────────────────
OVID_RUN_STALE_MS=15000
# The BullMQ prefix the staging gateway/worker ACTUALLY use. Their mains call
# createQueues/createAgentRunsWorker with NO `prefix` option, so BullMQ's
# default "bull" applies. Staging still cannot collide with prod because it
# uses a SEPARATE redis-q instance — that is the real isolation, not the
# prefix. This value must match the mains: setting it to "bull:staging" once
# made two chaos scenarios inspect queues nothing writes to.
BULL_PREFIX=bull

# ── Staging worker: workspaces / uids / capacity ───────────────────────────
# Distinct workspace root and uid range (prod: /workspaces/users, 200000).
OVID_WORKSPACES_ROOT=/workspaces-staging
OVID_SANDBOX_UID_BASE=220000
OVID_SANDBOX_UID_MAX=229999
OVID_MAX_ACTIVE_SANDBOXES=24
MAX_LIVE_BROWSERS=4
OVID_MAX_WARM_GB=8
OVID_DISK_ALERT_PCT=80
# Distinct cgroup branch — never the live worker's unit path.
OVID_CGROUP_BASE=ovid-sandboxes-staging.slice/ovid-staging-worker.service
OVID_ROOTFS=/opt/ovid-rootfs/current
OVID_BWRAP_PATH=/usr/bin/bwrap
# Staging-local browser state (distinct from /opt/ovid-cloud/browser-states).
OVID_BROWSER_STATE_DIR=/workspaces-staging/browser-states

# ── Staging storage (local fs — never the live R2 bucket) ──────────────────
OVID_STORAGE_BACKEND=fs
OVID_FS_STORAGE_ROOT=/workspaces-staging/storage

# ── Worker file service (own port; the live worker owns 8091) ──────────────
OVID_WORKER_FILE_PORT=18093
OVID_INTERNAL_TOKEN=staging-internal-token-0123456789abcdef0123456789abcdef

# ── Envelope master key (staging-only; exactly 64 hex chars) ───────────────
OVID_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Optional sandbox jail env (defaults are fine for staging) ──────────────
#OVID_SANDBOX_CPU_MAX="100000 100000"
#OVID_SANDBOX_MEMORY_MAX_MB=512
#OVID_SANDBOX_SWAP_MAX_MB=0
#OVID_SANDBOX_PIDS_MAX=64
#OVID_SANDBOX_DNS=1.1.1.1,9.9.9.9
