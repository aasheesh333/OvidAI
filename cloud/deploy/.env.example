# Ovid Cloud deploy environment — TEMPLATE ONLY, no real values.
#
# Copy to `.env` next to docker-compose.yml, fill EVERY CHANGE_ME, then
# `chmod 600 .env`. NEVER commit the filled file (deploy/.gitignore blocks it)
# and never paste its values into issues/reports. Live-stack secrets you need
# (mint-redis password) are in /opt/ovid-gateway/.env on the box — read them
# there at activation time.
#
# Format note: provision.sh sources this file with `.`, so keep it plain
# KEY=VALUE shell syntax (quotes optional, no spaces around `=`).

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Gateway ────────────────────────────────────────────────────────────────
# firebase = real Google ID-token + App Check verification. `test` is refused
# outright when NODE_ENV=production.
OVID_AUTH_MODE=firebase

# ── Host ports (loopback-only publications) ──────────────────────────────────
# GATEWAY_HOST_PORT: the gateway's published port (Caddy proxies /cloud/* to
# it — see the 8081 collision note above; caddy-snippet.conf must match).
GATEWAY_HOST_PORT=8082
# REDIS_Q_HOST_PORT: redis-q's published port for the HOST worker (P2 — the
# worker is systemd now, not a compose service). Must equal the port in
# /opt/ovid-cloud/worker.env's REDIS_Q_URL.
REDIS_Q_HOST_PORT=6391
# Loopback proxy ports (compose services net-proxy-pg / net-proxy-mint):
# 127.0.0.1:5434 → ovid-gateway-postgres-1:5432 and 127.0.0.1:6392 →
# ovid-gateway-redis-1:6379 for the host worker. Must equal the ports in
# worker.env's DATABASE_URL / REDIS_MINT_URL.
NET_PROXY_PG_HOST_PORT=5434
NET_PROXY_MINT_HOST_PORT=6392

# ── Worker: MOVED TO SYSTEMD (P2) ────────────────────────────────────────────
# The worker is no longer a compose service — it runs on the host as systemd
# unit ovid-worker.service. Its environment (DATABASE_URL/REDIS_* pointing
# at the loopback ports above, OVID_LITELLM_BASE=http://127.0.0.1:4000,
# OVID_DEFAULT_MODEL, and every OVID_* sandbox var) lives in
# /opt/ovid-cloud/worker.env — template: worker.env.example. Activation,
# gates and rollback: DEPLOY.md §11.
#
# P3 Task 16 adds these engine vars there (documented, defaults shown):
#   OVID_ANTHROPIC_BASE=https://api.anthropic.com
#   OVID_WINDOW_TOKENS=128000
#   OVID_APPROVAL_TIMEOUT_MS=120000
#   #GITHUB_API_TOKEN=            (optional; absent → repo_tree is not offered)

# ── Browser engine (P6) ───────────────────────────────────────────────────────
# The BROWSER runtime runs in the WORKER. On this box the worker is the host
# systemd unit (ovid-worker.service), so the LIVE copy of these vars is the
# "Browser engine (P6)" block in worker.env.example → /opt/ovid-cloud/
# worker.env. They are listed here too because the compose-worker VARIANT
# (P1's container worker, restorable from git history if ever needed — see
# the worker note in docker-compose.yml) would consume them from this file.
# These are the core knobs; the advanced screencast tuning vars
# (OVID_SCREENCAST_WIDTH/HEIGHT/QUALITY/EVERY_NTH_FRAME/MAX_FRAMES_IN_FLIGHT)
# are read by cloud/packages/browser/src/config.ts and intentionally not
# mirrored here. Full story: cloud/deploy/BROWSERS.md.
#
# Master key wrapping the per-user browser storageState envelopes
# (AES-256-GCM; KEK = sha256(OVID_MASTER_KEY)). Generate with:
#   openssl rand -hex 32
# REQUIRED in production: an EMPTY value makes the worker REFUSE TO BOOT,
# naming this variable (P6 Task 14 fail-fast — never run with it unset).
# Shared with P9's escrow (spec §11) — one key, escrowed the same way.
OVID_MASTER_KEY=CHANGE_ME
# Encrypted per-user browser-state blobs (users/{uid}/browser/main.zst).
# Under the host-systemd worker this is a DIRECT host path; under the
# compose-worker variant it is the ovid-browser-states named volume
# (docker-compose.yml worker note). Local-disk store until P7/R2.
OVID_BROWSER_STATE_DIR=/opt/ovid-cloud/browser-states
# Pinned Lightpanda 1.0.1 — provisioned by cloud/deploy/install-lightpanda.sh
# (owner-gated; checksum-verified). MUST be set in production, else tier-1
# silently skips Lightpanda and only the linkedom/chromium fallbacks run.
OVID_LIGHTPANDA_BIN=/opt/ovid-browsers/lightpanda-1.0.1/lightpanda
# Chromium install root (playwright-core 1.64.1 ⇒ Chromium 156.0.8078.4).
# Activation installs into it; see BROWSERS.md §(b) for the exact command.
PLAYWRIGHT_BROWSERS_PATH=/opt/ovid-browsers/ms-playwright
# Same value as worker.env.example (P2) — the per-uid workspace root the
# browser tools resolve artifact paths against.
OVID_WORKSPACES_ROOT=/workspaces/users
# The VPS's OWN public IPv4 — the app-level SSRF guard blocks navigation to
# it, and P2's nftables rules drop it for the sandbox/browser uids. Same
# value the nft installer consumes (worker.env.example, egress section).
# This box: 148.113.44.36.
OVID_PUBLIC_IP=CHANGE_ME
# The uid browser/chromium processes run as, for P2's owner-match nftables
# egress drops (BROWSERS.md §(d)). Coordinate the value with P2's uid plan —
# it is the WORKER's uid, not a sandbox jail uid block.
OVID_BROWSER_EGRESS_UID=CHANGE_ME
# Admission/eviction knobs — commented = built-in default (pinned by the P6
# Global Constraints; BROWSERS.md §(c) has the budget math). Malformed
# values make the worker refuse to boot naming the variable.
#MAX_LIVE_BROWSERS=4
#MAX_TIER1_FALLBACK_CONTEXTS=2
#MAX_TIER1_PROCESSES=8
#MAX_ACTIVE_SCREENCASTS=3
#BROWSER_IDLE_EVICT_MS=180000
#TIER1_TIMEOUT_MS=20000
#OVID_SCREENCAST_LOAD_MAX=6.0
# MUST stay EMPTY in production: it lets the SSRF guard reach private/loopback
# hosts (tests use 127.0.0.1,localhost against local fixtures). Only ever set
# it for test runs.
#OVID_BROWSER_ALLOW_HOSTS=

# The ovid_cloud database, provisioned by provision.sh on the live postgres
# (reached over the ovid-gateway_internal docker network by container DNS).
DATABASE_URL=postgres://ovid_cloud:CHANGE_ME@ovid-gateway-postgres-1:5432/ovid_cloud
# Must equal the password embedded in DATABASE_URL. provision.sh uses it for
# CREATE ROLE and refuses to run while it contains CHANGE_ME. Generate with:
#   openssl rand -hex 24
# (alphanumeric only — provision.sh validates; it is quoted into SQL safely.)
OVID_CLOUD_DB_PASSWORD=CHANGE_ME

# Queue + event-log Redis (the redis-q compose service; password must match).
# Generate with: openssl rand -hex 24
REDIS_Q_URL=redis://:CHANGE_ME@redis-q:6379
REDIS_Q_PASSWORD=CHANGE_ME

# The live stack's mint Redis (db 2 — per-user provisioned LiteLLM keys) and
# the mint HTTP API — consumed by the GATEWAY container over the internal
# network. (The HOST worker reaches the same redis through net-proxy-mint /
# 127.0.0.1:6392 — see worker.env.example.) The password is REDIS_PASSWORD
# from /opt/ovid-gateway/.env (read it on the box; never commit it).
REDIS_MINT_URL=redis://:CHANGE_ME@ovid-gateway-redis-1:6379/2
MINT_BASE_URL=http://ovid-gateway-mint-1:8090

# Firebase Admin SDK credentials INSIDE the gateway container. The default
# compose setup bind-mounts the host file below read-only to the container
# path (mount-vs-copy decision: DEPLOY.md §3). /opt/ovid-gateway/
# firebase-admin.json already exists on the box.
GOOGLE_APPLICATION_CREDENTIALS=/etc/ovid/firebase-admin.json
FIREBASE_CREDENTIALS_HOST_PATH=/opt/ovid-gateway/firebase-admin.json

# ── Mint (P9 Task 3 — BUILD-ONLY compose service) ──────────────────────────
# The Node port of server/mint/mint.py (cloud/apps/mint). The compose `mint`
# service is behind the `mint` profile: a plain `docker compose up` never
# starts it. Activation (Caddy flips + this env block's real values) is the
# owner-gated Task 18. DATABASE_URL/NODE_ENV above are shared with it.
# In-container listener ports are fixed (8091 public / 8092 admin); the
# compose publications are 127.0.0.1:8091/8092.
# Live stack's mint Redis db2 (per-user provisioned keys). The URL carries
# the db selector — keep the /2. Password = REDIS_PASSWORD from
# /opt/ovid-gateway/.env (read it on the box; never commit it).
REDIS_DB2_URL=redis://:CHANGE_ME@ovid-gateway-redis-1:6379/2
# The live stack's LiteLLM admin API + master key (also in
# /opt/ovid-gateway/.env on the box).
LITELLM_BASE=http://ovid-gateway-litellm-1:4000
LITELLM_MASTER_KEY=CHANGE_ME
# Admin console bearer key (the new mint's /admin guard — replaces the
# Python stack's value) and the internal server-to-server minting secret
# (gateway/worker → mint, P9 Task 9). Generate with: openssl rand -hex 24
OVID_ADMIN_MASTER_KEY=CHANGE_ME
OVID_INTERNAL_API_SECRET=CHANGE_ME
FIREBASE_PROJECT_ID=CHANGE_ME
# Allowed App Check app ids per platform ("android:<appId>,web:<appId>").
OVID_APPCHECK_APPS=android:CHANGE_ME,web:CHANGE_ME
# Base URL handed to clients in the /mint response.
#PUBLIC_BASE_URL=https://cloud.dhanuksoftwares.com/v1
# Operator alerts (Telegram + webhook); empty = that channel is off.
#ALERT_TELEGRAM_BOT_TOKEN=
#ALERT_TELEGRAM_CHAT_ID=
#ALERT_WEBHOOK_URL=
#DAILY_SPEND_ALERT_USD=20
# Every knob below keeps its mint.py default when commented out.
#MINT_STATE_DIR=/data
#REAPPLY_SYNC_MAX=200
#AUDIT_MAX=5000
#USAGE_CACHE_S=15
#MINT_SWEEP_S=30
#WEB_TEAM_DAILY_USD=25
# Abuse ceilings (defaults 40/3600/12/600/86400/20/3600/500/3600):
#MINT_CALLS_PER_IP=40
#MINT_WINDOW_S=3600
#NEW_ACCOUNTS_PER_IP_PER_WINDOW=12
#SIGNUP_VELOCITY_WINDOW_S=600
#IP_ACCOUNT_WINDOW_S=86400
#ABUSE_STRIKE_LIMIT=20
#ABUSE_WINDOW_S=3600
#GLOBAL_NEWKEYS_PER_WINDOW=500
#NEWKEY_WINDOW_S=3600
# Google Play billing (P9 Task 10). Service account file is an env PATH.
#OVID_PLAY_SERVICE_ACCOUNT_FILE=
#OVID_PLAY_PACKAGE=com.dhanuk.ovidai
#OVID_PLAY_PRODUCTS=
#OVID_RTDN_AUDIENCE=
#OVID_RTDN_SERVICE_ACCOUNT=
#OVID_RTDN_SHARED_SECRET=
#OVID_BILLING_REQUIRE_ACCOUNT_ID=true
# Images gateway (P9 Tasks 12–14).
#OVID_IMAGE_MAX_UPSTREAM_USD=1.00
#INFERHUB_API_KEY=
#OVID_IMAGE_DIRECT_EDIT_HOSTS=api.inferhub.dev
#OVID_IMAGE_EDIT_COST_USD=
#OVID_PROBE_KEY=
#OVID_PROBE_MAX_USD=0.50
#OVID_PROBE_DAILY_USD=5.00
#OVID_PROBE_TTL_SECONDS=604800
#OVID_PROBE_STAGGER_SECONDS=30
#OVID_PROBE_MAX_SIZES=4
# NEVER set ALLOW_TEST_UPGRADE=true: it is refused outright when
# NODE_ENV=production and exists only for the e2e tier tests.

# ── Backups (deploy/backup/pg_backup.sh — NOT consumed by compose) ─────────
# For the systemd timer these live in /opt/ovid-cloud/backup.env instead
# (see backup/README.md); they are listed here so one template covers both.
BACKUP_DIR=/opt/ovid-backups/pg
BACKUP_MIN_FREE_MB=2048
BACKUP_RETENTION_DAYS=14
# Space-separated explicit DB list; default = every non-template DB on the
# live postgres (works before AND after ovid_cloud exists).
#BACKUP_DBS=ovid_cloud litellm
#PG_CONTAINER=ovid-gateway-postgres-1
# Optional offsite copies to Cloudflare R2 via the S3 API (requires the aws
# CLI on the host). When ANY of these is unset, backups stay local-only and
# pg_backup.sh says so loudly.
#OVID_R2_ACCOUNT_ID=
#OVID_R2_BUCKET=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
