# Ovid Cloud HOST worker environment — TEMPLATE ONLY, no real values.
#
# The worker left compose in P2 (it jails user code on the host and needs
# cgroup/nftables/workspaces access a container cannot have). It runs as a
# systemd unit (cloud/deploy/systemd/ovid-worker.service, DEPLOY.md §11)
# whose EnvironmentFile points here: /opt/ovid-cloud/worker.env.
#
# Copy to /opt/ovid-cloud/worker.env, fill EVERY CHANGE_ME, then
# `chmod 600 /opt/ovid-cloud/worker.env`. NEVER commit the filled file and
# never paste its values into issues/reports. Live-stack secrets you need
# (mint-redis password) are in /opt/ovid-gateway/.env on the box — read them
# there at activation time.
#
# Format note: plain KEY=VALUE shell syntax (systemd EnvironmentFile accepts
# the same). Every OVID_* sandbox variable below carries its Task-2 default
# (cloud/packages/sandbox/src/config.ts) — the explicit values make the
# running configuration auditable in one file; leave a var commented to take
# the built-in default. An EMPTY value counts as unset, except where noted.
#
# The worker reaches the compose network over LOOPBACK PROXIES (compose
# services net-proxy-pg/net-proxy-mint/redis-q's host port — DEPLOY.md §11
# step 6); the live ovid-gateway stack itself is untouched.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Backends (over the loopback proxies — compose must be up, §11 step 6) ───
# net-proxy-pg publishes 127.0.0.1:5434 → ovid-gateway-postgres-1:5432.
# Same password as OVID_CLOUD_DB_PASSWORD in cloud/deploy/.env.
DATABASE_URL=postgres://ovid_cloud:CHANGE_ME@127.0.0.1:5434/ovid_cloud
# redis-q's published host port (127.0.0.1:6391). Same password as
# REDIS_Q_PASSWORD in cloud/deploy/.env.
REDIS_Q_URL=redis://:CHANGE_ME@127.0.0.1:6391
# net-proxy-mint publishes 127.0.0.1:6392 → ovid-gateway-redis-1:6379.
# Password = REDIS_PASSWORD from /opt/ovid-gateway/.env; the /2 db selector
# is part of the URL.
REDIS_MINT_URL=redis://:CHANGE_ME@127.0.0.1:6392/2

# ── Internal mint API (P9 Task 9) ──────────────────────────────────────────
# The worker signs its own uid (HMAC-SHA256 over
# "POST\n/internal/mint-key\n<uid>\n<timestamp>") and calls mint's ADMIN
# listener for UNATTENDED runs whose key is missing from db2. Attended runs
# keep the key_not_minted contract (the client mints through the gateway).
# The compose mint service publishes 127.0.0.1:8092 on the host.
OVID_INTERNAL_MINT_URL=http://127.0.0.1:8092
# MUST equal OVID_INTERNAL_API_SECRET in cloud/deploy/.env (mint + gateway)
# and be at least 32 bytes. Generate with: openssl rand -hex 32
OVID_INTERNAL_API_SECRET=CHANGE_ME

# ── Model routing ───────────────────────────────────────────────────────────
# LiteLLM already publishes on host loopback (DEPLOY.md §0).
OVID_LITELLM_BASE=http://127.0.0.1:4000
# A model alias configured in the live LiteLLM (admin dashboard:
# 127.0.0.1:8081 via SSH tunnel). The worker refuses to boot without it.
OVID_DEFAULT_MODEL=CHANGE_ME

# ── Agent engine (P3 Task 16) ───────────────────────────────────────────────
# BYOK anthropic leg base (the transport appends /v1/messages — no /v1 here).
OVID_ANTHROPIC_BASE=https://api.anthropic.com
# Model context window used for compaction decisions.
OVID_WINDOW_TOKENS=128000
# Approval card timeout (ms). Attended question/plan cards still wait forever;
# unattended runs time out to DENY and continue (spec §8).
OVID_APPROVAL_TIMEOUT_MS=120000
# Optional GitHub REST token backing repo_tree. Absent/empty → the github port
# is null and repo_tree is not advertised in the roster.
#GITHUB_API_TOKEN=

# ── Scheduler (P4) ──────────────────────────────────────────────────────────
# Settle-then-tick cadence for scheduled tasks (ms; default 15000, Dart
# parity). Optional; a non-positive/non-integer value fails boot loudly,
# naming the variable. The loop also runs the settle reconciler every pass.
#OVID_SCHEDULER_TICK_MS=15000
# FCM push (scheduled-task results + unattended approval cards). The HOST
# worker reads the live stack's Firebase service-account file DIRECTLY — no
# container mount (the compose gateway mounts the same file; DEPLOY.md §3).
# Absent/unreadable → pushes fail soft (logged once), the worker stays up.
GOOGLE_APPLICATION_CREDENTIALS=/opt/ovid-gateway/firebase-admin.json

# ── Browser engine (P6 Task 16) ──────────────────────────────────────────────
# The P6 browser runtime lives IN the worker (two-tier engine: linkedom /
# Lightpanda tier-1 + Playwright chromium tier-2, per-user encrypted
# storageState, CDP screencast). Full provisioning/capacity/egress story:
# cloud/deploy/BROWSERS.md. The compose `.env.example` "Browser engine (P6)"
# block documents the same vars for the dormant compose-worker variant.
#
# Master key wrapping the per-user browser storageState envelopes (binary v1:
# AES-256-GCM, KEK = sha256(OVID_MASTER_KEY)). Generate with:
#   openssl rand -hex 32
# REQUIRED in production: an EMPTY value makes the worker REFUSE TO BOOT,
# naming this variable (P6 Task 14 fail-fast). Shared with P9's escrow
# (spec §11).
OVID_MASTER_KEY=CHANGE_ME
# Encrypted per-user browser-state blobs (users/{uid}/browser/main.zst) —
# a DIRECT host path under the host-systemd worker (the compose-worker
# variant would use the ovid-browser-states named volume). Local-disk store
# until P7/R2 swaps the adapter for the real browser_states table (ruling
# R2 — P6 never creates the table).
OVID_BROWSER_STATE_DIR=/opt/ovid-cloud/browser-states
# Pinned Lightpanda 1.0.1 — provisioned by cloud/deploy/install-lightpanda.sh
# (owner-gated; sha256-verified). MUST be set in production, else tier-1
# SILENTLY skips Lightpanda and only the linkedom/chromium fallbacks run
# (missing-binary is handled, never crashes the worker). NOTE: the dev
# checkout on this box keeps the binary at /tmp/ovid-lightpanda-dl/
# lightpanda (agents cannot write /opt) — production hosts MUST run the
# installer instead of trusting /tmp. Ports 9400-9407 are one-pool-per-host
# EXCLUSIVE: never run a second worker/pool on the same host.
OVID_LIGHTPANDA_BIN=/opt/ovid-browsers/lightpanda-1.0.1/lightpanda
# Chromium install root (playwright-core 1.64.1 ⇒ Chromium 156.0.8078.4);
# the activation step in BROWSERS.md §(b) installs into it.
PLAYWRIGHT_BROWSERS_PATH=/opt/ovid-browsers/ms-playwright
# Admission/eviction knobs — commented = built-in default (Pinned by the P6
# Global Constraints; budget math in BROWSERS.md §(c)). Malformed values
# make the worker refuse to boot naming the variable.
#MAX_LIVE_BROWSERS=4
#MAX_TIER1_FALLBACK_CONTEXTS=2
#MAX_TIER1_PROCESSES=8
#MAX_ACTIVE_SCREENCASTS=3
#BROWSER_IDLE_EVICT_MS=180000
#TIER1_TIMEOUT_MS=20000
#OVID_SCREENCAST_LOAD_MAX=6.0
# MUST stay EMPTY in production: it lets the SSRF guard reach private/loopback
# hosts (tests use 127.0.0.1,localhost against local fixtures). Never set it
# on the live worker.
#OVID_BROWSER_ALLOW_HOSTS=
# OVID_PUBLIC_IP (egress-filter section below) and OVID_BROWSER_EGRESS_UID
# also serve the P6 browser egress story — see BROWSERS.md §(d).

# ── Sandbox: rootfs / uids / capacity (Task 2 defaults) ─────────────────────
# Per-uid workspace root — on the XFS volume setup-workspaces.sh creates.
OVID_WORKSPACES_ROOT=/workspaces/users
# Rootfs install root. CURRENT artifact revision:
# dist/ubuntu-noble-min-20261017-r2.tar.zst (Task 10 rebuild — carries the
# cache-prune shim). /tmp/ovid-rootfs-test is the STALE r1 scratch from
# earlier tasks — never point production (or a host-gated suite) at it.
OVID_ROOTFS=/opt/ovid-rootfs/current
OVID_CGROUP_ROOT=/sys/fs/cgroup
# Jail envs live UNDER the worker's own unit in the cgroup hierarchy —
# do not change without matching systemd/ units.
OVID_CGROUP_BASE=ovid-sandboxes.slice/ovid-worker.service
# Production uid block (spec §11): 200000-209999. Staging (P10) sets
# 220000-229999 from the same vars.
OVID_SANDBOX_UID_BASE=200000
OVID_SANDBOX_UID_MAX=209999
# Capacity (revised 8 vCPU / 22 GB box): 24 x 512 MiB worst case binds at the
# 10G slice first — per-env OOM, host protected.
OVID_MAX_ACTIVE_SANDBOXES=24
OVID_ACQUIRE_TIMEOUT_MS=60000
# XFS project quotas (MB): free-tier workspace, Pro workspace, agent store.
OVID_WORKSPACE_QUOTA_MB=500
OVID_PRO_WORKSPACE_QUOTA_MB=2048
OVID_STORE_QUOTA_MB=2048
# Warm-sandbox cache ceiling (GB) inside the /workspaces volume — tuning
# note in HARDENING.md item H. The value is DEFINED ONCE, in the Storage (P7)
# block below ("The ONE warm-disk knob", P7 ruling R2) — do not re-add it
# here: this file is sourced with `.`, so a duplicate would silently make the
# LAST assignment win.

# ── Sandbox: per-env cgroup caps (spec §7.3 / Task 2 defaults) ──────────────
# The cpu.max value is a quota PERIOD pair — QUOTED because it contains a
# space (a bash `source` of this file breaks on an unquoted space, and the
# quoting is harmless for the systemd EnvironmentFile consumer: quotes are
# stripped, the value reaches the worker as `100000 100000` either way).
OVID_SANDBOX_CPU_MAX="100000 100000"
OVID_SANDBOX_MEMORY_MAX_MB=512
OVID_SANDBOX_SWAP_MAX_MB=0
OVID_SANDBOX_PIDS_MAX=64

# ── Sandbox: jail environment ───────────────────────────────────────────────
OVID_SANDBOX_DNS=1.1.1.1,9.9.9.9
OVID_BWRAP_PATH=/usr/bin/bwrap
# Default resolves to <repo>/cloud/packages/sandbox/bin/sandbox-enter.sh —
# leave commented unless the checkout layout differs.
#OVID_SANDBOX_LAUNCHER=/opt/ovid-cloud/repo/cloud/packages/sandbox/bin/sandbox-enter.sh
# Launch strategy: "setuid" (branch a default) or "rootmap" (branch c).
# Mirror MECHANISM.md's DECISION here — leave commented to take the setuid
# default; set explicitly once the probe's DECISION is filled.
#OVID_SANDBOX_LAUNCH=setuid

# ── Egress filter (consumed by deploy/net/install-nft.sh, §11 step 4) ───────
# REQUIRED at nft-install time: this host's public IPv4 (sandbox uids must
# not reach it). This box: 148.113.44.36.
OVID_PUBLIC_IP=CHANGE_ME
# Optional csv of extra blocked cidrs / P6 browser-egress knobs — leave
# commented unless the owner sets them.
#OVID_SANDBOX_EXTRA_BLOCKED=
#OVID_BROWSER_EGRESS_UID=
#OVID_BROWSER_EGRESS_ALLOW=

# ── Worker tuning (optional — positive integer ms; empty value REFUSES boot) ─
# Stale-run sweeper threshold (default 600000). Leave COMMENTED unless
# overriding: an empty value makes the worker refuse to boot.
#OVID_RUN_STALE_MS=600000
# C1 cap on how long a run may wait for older active runs of the same
# session before run_queue_wait_timeout (default 600000). Same rule.
#OVID_RUN_QUEUE_WAIT_MS=600000

# ── Storage (P7) ────────────────────────────────────────────────────────────
# Workspace hibernation/hydration + lazy files. The worker reads THIS file
# (systemd EnvironmentFile); the gateway reads cloud/deploy/.env. The shared
# values below MUST MATCH the gateway's "Storage (P7)" block:
#   OVID_STORAGE_BACKEND, OVID_R2_*, OVID_INTERNAL_TOKEN, REDIS_C_PASSWORD.
# PROVISIONING IS OWNER-GATED — see cloud/deploy/R2-PROVISIONING.md.
#
# Production storage = Cloudflare R2 (spec §10/D7). An incomplete OVID_R2_*
# block fails LOUDLY at boot; the fs backend is refused when NODE_ENV=production.
OVID_STORAGE_BACKEND=r2
OVID_R2_ACCOUNT_ID=CHANGE_ME
OVID_R2_ACCESS_KEY_ID=CHANGE_ME
OVID_R2_SECRET_ACCESS_KEY=CHANGE_ME
OVID_R2_BUCKET=ovid-cloud
# Optional S3-compatible endpoint override (dev/staging only).
#OVID_R2_ENDPOINT=

# Cache-class Redis (spec §10 redis-c) over its LOOPBACK publication
# (docker-compose.yml redis-c, host port REDIS_C_HOST_PORT=6393). Password =
# REDIS_C_PASSWORD in cloud/deploy/.env. Unset/empty → falls back to
# REDIS_Q_URL with a boot warning (fails safe, less isolation).
REDIS_C_URL=redis://:CHANGE_ME@127.0.0.1:6393

# The ONE warm-disk knob (P7 ledger ruling R2; shared with P2's attach-guard).
# Default 8 GB; the 8 → 12 GB retune is the owner's activation decision.
OVID_MAX_WARM_GB=8
# Disk-pressure alert threshold (percent of /workspaces; default 80).
OVID_DISK_ALERT_PCT=80

# Internal-only file service (P7 Task 11). OVID_INTERNAL_TOKEN is REQUIRED
# (non-empty) and must equal the gateway's value — one shared secret:
#   openssl rand -hex 32
OVID_INTERNAL_TOKEN=CHANGE_ME
OVID_WORKER_FILE_PORT=8091
# Worker-side hydrate timeout (ms; default 60000). The gateway's matching
# wait is OVID_HYDRATE_WAIT_MS (default 20000) in cloud/deploy/.env.
#OVID_HYDRATE_TIMEOUT_MS=60000
# Inline-file cap — name DIVERGENCE is deliberate (P7 Task 12): the WORKER
# reads OVID_INLINE_MAX_BYTES, the GATEWAY reads OVID_FILE_INLINE_MAX_BYTES.
# Keep the values equal (default 1 MiB).
#OVID_INLINE_MAX_BYTES=1048576

# libuv threadpool headroom (spike §4.4): the packer's async zstd compression
# and fs work share this pool. Eight threads keeps a 200 MB pack from
# serializing behind four default threads.
UV_THREADPOOL_SIZE=8

# Dev/test ONLY: local filesystem storage backend (refused in production).
#OVID_FS_STORAGE_ROOT=/tmp/ovid-storage

# /workspaces is already mounted by deploy/workspaces/setup-workspaces.sh
# (P2, §11 step 3); OVID_WORKSPACES_ROOT=/workspaces/users above is unchanged.
# No P7 mount is needed for the host worker.
