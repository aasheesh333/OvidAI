# Ovid Cloud P10 — STAGING mint environment template.
#
# Copy to `cloud/deploy/.env.staging.mint` (gitignored), then `chmod 600`.
# This file configures the REAL P9 mint service (`cloud/apps/mint`) inside
# the staging composition — never an HTTP mock. Container-side URLs use the
# compose service names (postgres / redis-mint).
#
# The mint's boot re-sync seeds plans/settings into the fresh staging
# Postgres and publishes the db2 projection (P9 Task 5); `staging.sh up`
# waits for `config:limits` on redis-mint db2 before polling gateway health.

NODE_ENV=development
HOST=0.0.0.0
PUBLIC_PORT=8091
ADMIN_PORT=8092

# ── Staging Postgres / redis-mint (db2 projection) ─────────────────────────
DATABASE_URL=postgres://postgres:staging@postgres:5432/ovid_cloud_staging
REDIS_DB2_URL=redis://:staging@redis-mint:6379/2

# ── LiteLLM admin stub (served by the Task 4 mock at the host bridge IP) ───
# The mint provisions staging keys through LiteLLM's admin API. Point it at
# the mock, never at the live LiteLLM (:4000 / ovid-gateway-litellm-1).
LITELLM_BASE=http://172.17.0.1:14000
LITELLM_MASTER_KEY=sk-staging-mock-master

# ── Admin console + internal HMAC secret ───────────────────────────────────
# Staging-only literals. OVID_INTERNAL_API_SECRET MUST match
# `.env.staging` exactly (the gateway/worker sign with the same value).
OVID_ADMIN_MASTER_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
OVID_INTERNAL_API_SECRET=staging-internal-api-secret-0123456789abcdef0123456789abcdef

# ── Firebase / App Check (staging placeholders; App Check off) ─────────────
FIREBASE_PROJECT_ID=ovid-staging
APPCHECK_ENABLED=false

# ── Projection / state ─────────────────────────────────────────────────────
# Fresh staging DB: the mint's boot re-sync is authoritative and publishes
# the db2 projection from Postgres.
MINT_PROJECTION_MODE=authoritative
MINT_STATE_DIR=/data

# The test-upgrade hatch must stay off (and is refused when NODE_ENV is
# production anyway).
ALLOW_TEST_UPGRADE=false

# Base URL handed to clients in /mint responses (staging public listener).
PUBLIC_BASE_URL=http://127.0.0.1:18091/v1
