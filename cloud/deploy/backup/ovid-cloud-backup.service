# Nightly Postgres backup run (all non-template DBs on ovid-gateway-postgres-1
# → pg_dump | zstd -9 → /opt/ovid-backups/pg/<ts>/, optional R2 upload).
# Install: copy this file and ovid-cloud-backup.timer to /etc/systemd/system/,
# run `systemctl daemon-reload`, then `systemctl enable --now ovid-cloud-backup.timer`.
[Unit]
Description=Ovid — Postgres backups with provable restore
Documentation=file:/opt/ovid-cloud/repo/cloud/deploy/backup/README.md
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
# Optional 0600 file with BACKUP_*/OVID_R2_*/AWS_* overrides (template in
# cloud/deploy/.env.example, "Backups" section). Absent file is fine.
EnvironmentFile=-/opt/ovid-cloud/backup.env
# BACKUP_VERIFY=1 makes every run prove each dump restorable on a scratch DB.
ExecStart=/opt/ovid-cloud/repo/cloud/deploy/backup/pg_backup.sh
# Dumps share the disk with the live stack — keep them in the background.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Any nonzero exit (space guard, lock overlap, dump/upload/verification failure)
# leaves the unit failed: `systemctl status ovid-cloud-backup.service` / journalctl -u.
