# Nightly trigger for ovid-cloud-backup.service — 03:30 UTC (low traffic;
# after any local maintenance windows). Persistent=true: if the box was off
# at the scheduled time, the run fires on next boot.
[Unit]
Description=Nightly 03:30 UTC Ovid Postgres backup timer

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
Persistent=true
# Spread I/O slightly in case other nightly jobs align on the half hour.
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
