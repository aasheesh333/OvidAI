# syntax=docker/dockerfile:1
# Ovid Cloud gateway image. Build context = the cloud/ monorepo root:
#   docker build -f deploy/Dockerfile.gateway <cloud-dir>
# (docker compose does this automatically — context `..` in docker-compose.yml.)
#
# Multi-stage: full workspace install + tsc build, then a slim runtime with
# ONLY dist output, the drizzle/ migrations folder and production deps.

FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
# Native-build toolchain for the BUILD stage only. `pnpm install` runs
# node-pty's install script (packages/sandbox, allowed by pnpm-workspace.yaml's
# allowBuilds); its published prebuilds are darwin/win32 only, so on Linux it
# falls through to `node-gyp rebuild`. node:22-alpine ships no python3/make/g++.
# This stage is discarded — the runtime image below stays slim.
RUN apk add --no-cache python3 make g++ linux-headers
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
RUN pnpm -r build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /repo
RUN corepack enable
# Workspace manifests for EVERY importer in the lockfile (including e2e —
# --frozen-lockfile validates the whole workspace layout), then a prod-only
# install: typescript/vitest/drizzle-kit never reach the runtime image.
# allowBuilds from pnpm-workspace.yaml applies (firebase-admin needs
# @firebase/util's postinstall; msgpackr-extract falls back to pure JS).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/events/package.json packages/events/
COPY packages/queue/package.json packages/queue/
# Every workspace package the gateway imports (direct dependencies): storage
# (P7), account (P9), escrow (P10), mcp (P5). Missing manifests break the
# frozen-lockfile install; missing dist trees break `node main.js` at import.
COPY packages/storage/package.json packages/storage/
COPY packages/account/package.json packages/account/
COPY packages/escrow/package.json packages/escrow/
COPY packages/mcp/package.json packages/mcp/
COPY apps/gateway/package.json apps/gateway/
COPY apps/worker/package.json apps/worker/
COPY apps/e2e/package.json apps/e2e/
# P9 Task 3: apps/mint joined the workspace, so its manifest is now an
# importer in the lockfile — --frozen-lockfile validates every importer's
# presence. The gateway image never loads mint's code; only its manifest.
COPY apps/mint/package.json apps/mint/
# Built output the gateway loads at runtime — dist trees plus the drizzle/
# folder (migrate() resolves it relative to the package root, client.ts).
COPY --from=build /repo/packages/shared/dist ./packages/shared/dist
COPY --from=build /repo/packages/db/dist ./packages/db/dist
COPY --from=build /repo/packages/db/drizzle ./packages/db/drizzle
COPY --from=build /repo/packages/events/dist ./packages/events/dist
COPY --from=build /repo/packages/queue/dist ./packages/queue/dist
COPY --from=build /repo/packages/storage/dist ./packages/storage/dist
COPY --from=build /repo/packages/account/dist ./packages/account/dist
COPY --from=build /repo/packages/escrow/dist ./packages/escrow/dist
COPY --from=build /repo/packages/mcp/dist ./packages/mcp/dist
COPY --from=build /repo/apps/gateway/dist ./apps/gateway/dist
RUN pnpm install --frozen-lockfile --prod
USER node
# main.ts is the process entry (direct-run guard around main() from index.ts).
CMD ["node", "apps/gateway/dist/main.js"]
