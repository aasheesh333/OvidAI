# Ovid cloud watch — TEMPLATE ONLY, no real values.
#
# Copy to /opt/ovid-cloud/watch.env, fill EVERY CHANGE_ME, then:
#   sudo chmod 600 /opt/ovid-cloud/watch.env
# NEVER commit the filled file and never paste its values into issues/reports.
#
# Plain KEY=VALUE shell syntax (systemd EnvironmentFile accepts the same).
# Every default below matches cloud/apps/watch/src/env.ts; an EMPTY value
# counts as unset for the string vars.

# ── Alert delivery (mint's existing mechanism — do not invent a second one) ──
# Reuse the values already in mint's environment. Both are required together;
# the optional webhook is sent in addition when set.
ALERT_TELEGRAM_BOT_TOKEN=CHANGE_ME
ALERT_TELEGRAM_CHAT_ID=CHANGE_ME
#OVID_ALERT_WEBHOOK_URL=

# ── State ───────────────────────────────────────────────────────────────────
WATCH_STATE_FILE=/var/lib/ovid-cloud-watch/state.json

# ── Gateway ─────────────────────────────────────────────────────────────────
# Published loopback port of the cloud gateway (compose: 8081; the plan's
# pinned health URL uses 8082 — set whichever this box actually publishes).
GATEWAY_HEALTH_URL=http://127.0.0.1:8082/cloud/v1/health

# ── Queue / worker (redis-q) ────────────────────────────────────────────────
# The cloud queue's published host port + password (same values as the
# worker's REDIS_Q_URL). BullMQ prefix must match the deployment (prod: bull;
# staging: bull:staging).
REDIS_Q_URL=redis://:CHANGE_ME@127.0.0.1:6391
WATCH_QUEUE_PREFIX=bull
WATCH_QUEUE_NAMES=agent-runs,schedules

# ── Disk / memory ───────────────────────────────────────────────────────────
WATCH_DISK_PATH=/
WATCH_QUEUE_WAITING=50
WATCH_WORKER_LAG_S=300
WATCH_DISK_PCT=80
WATCH_REDIS_MEM_PCT=80

# ── Spend parity (integer cents) ────────────────────────────────────────────
# Read-only connection to LiteLLM's Postgres (the LiteLLM_SpendLogs table is
# in LiteLLM's own DB, not ovid_cloud) and the mint db2 projection URL. Set
# WATCH_SPEND_PARITY=off only when one side is genuinely unavailable; an
# enabled check with a missing seam fails loudly.
WATCH_SPEND_PARITY=on
WATCH_LITELLM_DATABASE_URL=postgres://readonly:CHANGE_ME@127.0.0.1:5434/litellm
REDIS_MINT_URL=redis://:CHANGE_ME@127.0.0.1:6392/2
WATCH_SPEND_DRIFT_CENTS=100
WATCH_SPEND_DRIFT_PCT=2

# ── Cadence / timeouts ──────────────────────────────────────────────────────
# Re-alert a still-failing check only after this quiet window (seconds).
WATCH_REPEAT_AFTER_S=1800
WATCH_HTTP_TIMEOUT_MS=5000
