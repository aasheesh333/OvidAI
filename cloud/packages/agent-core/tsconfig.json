{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Same rationale as the gateway/worker tsconfigs: approvals.ts (P3 Task
    // 12) consumes @ovid/db, whose .d.ts files pull in drizzle-orm
    // declarations referencing optional peer deps (gel, mysql2, …) that fail
    // whole-program lib checking. skipLibCheck only skips .d.ts files; our
    // sources stay fully checked.
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
