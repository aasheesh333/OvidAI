{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // linkedom's bundled types intentionally shadow lib.dom declarations and
    // only typecheck cleanly with skipLibCheck (per linkedom's docs).
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
